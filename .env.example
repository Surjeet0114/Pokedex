# Copy this file to .env and replace each example with a unique random value.
DB_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes-for-jwt-signing
FLASK_SECRET_KEY=replace-with-a-long-random-flask-session-key
SESSION_COOKIE_SECURE=false
WEB_PORT=5000
CORS_ORIGIN=http://localhost:5000
